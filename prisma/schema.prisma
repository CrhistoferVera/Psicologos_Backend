generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  phoneNumber         String    @unique
  phoneDialCode       String?
  phoneNationalNumber String?
  phoneCountryIso     String?
  phoneCountryName    String?
  billingRegion       String?
  preferredCurrency   String?
  email               String?   @unique
  referralCode        String?   @unique
  password            String?
  firstName           String?
  lastName            String?
  fcmToken            String?
  isProfileComplete   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLogin           DateTime?
  role                UserRole  @default(USER)
  resetPasswordExpiry DateTime?
  resetPasswordToken  String?
  isActive            Boolean   @default(true)
  stripeCustomerId    String?   @unique

  professionalProfile                ProfessionalProfile?
  userProfile                        UserProfile?
  wallet                             Wallet?
  depositRequests                    DepositRequest[]
  conversationsAsUser1               Conversation[]                      @relation("ConversationUser1")
  conversationsAsUser2               Conversation[]                      @relation("ConversationUser2")
  sentMessages                       Message[]                           @relation("SentMessages")
  professionalSpecialties            ProfessionalSpecialty[]
  promotionalCreditsGranted          PromotionalCreditGrant[]            @relation("PromotionalCreditsGrantedBy")
  promotionalCreditsReceived         PromotionalCreditGrant[]            @relation("PromotionalCreditsReceivedBy")
  referralsSent                      Referral[]                          @relation("ReferralReferrer")
  referralAsReferred                 Referral?                           @relation("ReferralReferred")
  sessionsAsProfessional             Session[]                           @relation("ProfessionalSessions")
  sessionPayments                    SessionPayment[]                    @relation("ClientSessionPayments")
  professionalSessionOfferings       ProfessionalSessionOffering[]       @relation("ProfessionalSessionOfferings")
  professionalAvailabilityRules      ProfessionalAvailabilityRule[]      @relation("ProfessionalAvailabilityRules")
  professionalAvailabilityExceptions ProfessionalAvailabilityException[] @relation("ProfessionalAvailabilityExceptions")
  bookingsAsClient                   Booking[]                           @relation("ClientBookings")
  bookingsAsProfessional             Booking[]                           @relation("ProfessionalBookings")
  bookingEarningsAsClient            BookingEarning[]                    @relation("ClientBookingEarnings")
  bookingEarningsAsProfessional      BookingEarning[]                    @relation("ProfessionalBookingEarnings")
  reviewsAsClient                    BookingReview[]                     @relation("ClientReviews")
  reviewsAsProfessional              BookingReview[]                     @relation("ProfessionalReviews")
  bookingRescheduleRequestsRequested BookingRescheduleRequest[]          @relation("BookingRescheduleRequestedBy")
  bookingRescheduleRequestsResponded BookingRescheduleRequest[]          @relation("BookingRescheduleRespondedBy")
  immediateAvailability              ProfessionalImmediateAvailability?  @relation("ProfessionalImmediateAvailability")
  refundRequests                     RefundRequest[]                     @relation("ClientRefundRequests")
  clientPayoutAccounts               ClientPayoutAccount[]               @relation("ClientPayoutAccounts")

  @@index([billingRegion])
  @@index([phoneCountryIso])
  @@map("users")
}

model UserProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  userName       String?
  bio            String?  @db.Text
  avatarUrl      String?
  avatarPublicId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1    User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ProfessionalProfile {
  id             String                   @id @default(uuid())
  userId         String                   @unique
  username       String                   @unique
  dateOfBirth    DateTime?
  cedula         String?                  @unique
  idDocUrl       String?
  idDocPublicId  String?
  avatarUrl      String?
  avatarPublicId String?
  title          String?
  bio            String?
  education      Json?
  rateCredits    Int?
  isOnline       Boolean                  @default(false)
  reviewStatus   ProfessionalReviewStatus @default(PENDING)
  reviewNotes    String?
  availability   Json?
  coverPublicId  String?
  coverUrl       String?
  languages      String[] @default([])

  // KYC
  kycVideoUrl               String?
  kycVideoPublicId          String?
  kycSelfieUrl              String?
  kycSelfiePublicId         String?
  matriculaUrl              String?
  matriculaPublicId         String?
  tituloProfesionalUrl      String?
  tituloProfesionalPublicId String?
  kycFaceMatchScore         Float?
  kycFaceMatchStatus        KycFaceMatchStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts  BankAccount[]
  servicePrices ServicePrice[]

  @@map("professional_profiles")
}

model Wallet {
  id                 String   @id @default(uuid())
  userId             String   @unique
  balance            Decimal  @default(0.00) @db.Decimal(10, 2)
  promotionalBalance Decimal  @default(0.00) @db.Decimal(10, 2)
  balanceUsd         Decimal  @default(0.00) @db.Decimal(10, 2)
  debtBob            Decimal  @default(0.00) @db.Decimal(10, 2)
  debtUsd            Decimal  @default(0.00) @db.Decimal(10, 2)
  isBlocked          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt


  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  withdrawalRequests WithdrawalRequest[]
  bookingEarnings    BookingEarning[]

  @@map("wallets")
}

model ClientPayoutAccount {
  id                String       @id @default(uuid())
  clientId          String
  method            RefundMethod
  // Banco (cliente boliviano)
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  // Crypto (cliente extranjero)
  cryptoAddress     String?
  cryptoCurrency    String?
  cryptoNetwork     String?
  isDefault         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  client         User            @relation("ClientPayoutAccounts", fields: [clientId], references: [id], onDelete: Cascade)
  refundRequests RefundRequest[]

  @@index([clientId])
  @@map("client_payout_accounts")
}

model RefundRequest {
  id                    String       @id @default(uuid())
  bookingId             String       @unique
  clientId              String
  clientPayoutAccountId String
  amountBob             Decimal      @db.Decimal(10, 2)
  amountUsd             Decimal      @db.Decimal(10, 2)
  percentage            Int
  status                RefundStatus @default(PENDING)
  rejectionReason       String?
  receiptUrl            String?
  receiptPublicId       String?
  requestedAt           DateTime     @default(now())
  resolvedAt            DateTime?

  booking            Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client             User               @relation("ClientRefundRequests", fields: [clientId], references: [id], onDelete: Cascade)
  clientPayoutAccount ClientPayoutAccount @relation(fields: [clientPayoutAccountId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([status])
  @@map("refund_requests")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum RefundMethod {
  BANK_TRANSFER
  CRYPTO
}

model Package {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  credits   Int
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depositRequests DepositRequest[]

  @@map("packages")
}

model DepositRequest {
  id                    String        @id @default(uuid())
  userId                String
  packageId             String?
  paymentMethodId       String?
  amount                Decimal       @db.Decimal(10, 2)
  receiptUrl            String?
  receiptPublicId       String?
  stripePaymentIntentId String?       @unique
  bancoQrId             String?       @unique
  status                DepositStatus @default(PENDING)
  rejectionReason       String?
  creditsToDeliver      Int           @default(0)
  packageNameAtMoment   String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  package       Package?       @relation(fields: [packageId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  transaction   Transaction?

  @@map("deposit_requests")
}

model PaymentMethod {
  id            String      @id @default(uuid())
  type          PaymentType
  bankName      String?
  accountName   String?
  accountNumber String?
  qrImageUrl    String?
  qrPublicId    String?
  logoPublicId  String?
  logoUrl       String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  depositRequests DepositRequest[]

  @@map("payment_methods")
}

model Transaction {
  id                String          @id @default(uuid())
  walletId          String
  depositRequestId  String?         @unique
  type              TransactionType
  amount            Decimal         @db.Decimal(10, 2)
  promotionalAmount Decimal         @default(0.00) @db.Decimal(10, 2)
  realAmount        Decimal         @default(0.00) @db.Decimal(10, 2)
  isPromotional     Boolean         @default(false)
  description       String?
  createdAt         DateTime        @default(now())

  wallet                   Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  depositRequest           DepositRequest?         @relation(fields: [depositRequestId], references: [id])
  promotionalCreditGrant   PromotionalCreditGrant?
  asReferralReward         ReferralReward?         @relation("ReferralRewardTransaction")
  asReferralRewardReversal ReferralReward?         @relation("ReferralRewardReversalTransaction")
  bookingEarning           BookingEarning?

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

model ServicePrice {
  id          String      @id @default(uuid())
  profileId   String
  serviceType ServiceType
  price       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, serviceType])
  @@map("service_prices")
}

model Banks {
  id        Int       @id @default(autoincrement())
  name      String
  logo_url  String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  bankAccounts BankAccount[]
}

model BankAccount {
  id                    BigInt    @id @default(autoincrement())
  userId                String
  bankId                Int
  professionalProfileId String
  accountNumber         String    @db.VarChar(50)
  accountHolderName     String?   @db.VarChar(100)
  currency              String    @default("BOB")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt

  bank                Banks               @relation(fields: [bankId], references: [id])
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  withdrawalRequests  WithdrawalRequest[]

  @@index([userId])
  @@index([bankId])
  @@index([accountNumber])
  @@map("bank_accounts")
}

model WithdrawalRequest {
  id       String           @id @default(uuid())
  walletId String
  method   WithdrawalMethod @default(BANK_TRANSFER)

  // Cuenta bancaria (requerido si method = BANK_TRANSFER)
  bankAccountId BigInt?

  // Crypto wallet (requerido si method = CRYPTO)
  cryptoAddress  String? // Dirección 0x... del wallet
  cryptoCurrency String? // USDT, BNB, BTC, etc.
  cryptoNetwork  String? // BEP20, ERC20, TRC20, etc.

  credits         Decimal          @db.Decimal(10, 2)
  soles           Decimal          @db.Decimal(10, 2)
  currency        String           @default("BOB")
  status          WithdrawalStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  receiptUrl      String?
  receiptPublicId String?
  txId            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet      Wallet       @relation(fields: [walletId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("withdrawal_requests")
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionals ProfessionalSpecialty[]

  @@map("specialties")
}

model ProfessionalSpecialty {
  id             String   @id @default(uuid())
  professionalId String
  specialtyId    String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  professional User      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty    Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([professionalId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialties")
}

model PromotionalCreditGrant {
  id              String   @id @default(uuid())
  adminUserId     String
  recipientUserId String
  transactionId   String   @unique
  amount          Decimal  @db.Decimal(10, 2)
  reason          String?
  createdAt       DateTime @default(now())

  adminUser     User        @relation("PromotionalCreditsGrantedBy", fields: [adminUserId], references: [id], onDelete: Cascade)
  recipientUser User        @relation("PromotionalCreditsReceivedBy", fields: [recipientUserId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@index([adminUserId])
  @@map("promotional_credit_grants")
}

model Referral {
  id             String         @id @default(uuid())
  referrerUserId String
  referredUserId String         @unique
  codeUsed       String
  status         ReferralStatus @default(PENDING)
  referrerRole   UserRole
  referredRole   UserRole
  rewardPaidAt   DateTime?
  qualifiedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  referrer User             @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User             @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  rewards  ReferralReward[]

  @@index([referrerUserId])
  @@index([status, createdAt])
  @@map("referrals")
}

model ReferralReward {
  id                    String             @id @default(uuid())
  referralId            String
  type                  ReferralRewardType
  case                  ReferralCase
  currency              String
  sourceAmount          Decimal            @db.Decimal(10, 2)
  rewardPercent         Decimal            @db.Decimal(5, 2)
  rewardAmount          Decimal            @db.Decimal(10, 2)
  bookingId             String?
  bookingEarningId      String?
  depositRequestId      String?
  transactionId         String?            @unique
  reversedAt            DateTime?
  reversalTransactionId String?            @unique
  createdAt             DateTime           @default(now())

  referral            Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  transaction         Transaction? @relation("ReferralRewardTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  reversalTransaction Transaction? @relation("ReferralRewardReversalTransaction", fields: [reversalTransactionId], references: [id], onDelete: SetNull)

  @@index([referralId])
  @@index([bookingEarningId])
  @@index([depositRequestId])
  @@map("referral_rewards")
}

model Session {
  id                 String        @id @default(uuid())
  professionalUserId String
  title              String        @db.VarChar(200)
  durationMinutes    Int
  priceInBs          Decimal       @db.Decimal(10, 2)
  priceInUsd         Decimal       @db.Decimal(10, 2)
  status             SessionStatus @default(OPEN)
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  professional User             @relation("ProfessionalSessions", fields: [professionalUserId], references: [id], onDelete: Cascade)
  payments     SessionPayment[]

  @@index([professionalUserId])
  @@index([status])
  @@map("sessions")
}

model SessionPayment {
  id                    String               @id @default(uuid())
  sessionId             String
  clientUserId          String
  amountBs              Decimal              @db.Decimal(10, 2)
  amountUsd             Decimal              @db.Decimal(10, 2)
  currency              String
  status                SessionPaymentStatus @default(PENDING)
  bancoQrId             String?              @unique
  stripePaymentIntentId String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  User    @relation("ClientSessionPayments", fields: [clientUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientUserId])
  @@index([clientUserId])
  @@map("session_payments")
}

model ProfessionalSessionOffering {
  id              String   @id @default(uuid())
  professionalId  String
  title           String
  description     String?
  durationMinutes Int
  priceBob        Decimal  @db.Decimal(10, 2)
  priceUsd        Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  professional User      @relation("ProfessionalSessionOfferings", fields: [professionalId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([professionalId])
  @@index([isActive])
  @@map("professional_session_offerings")
}

model ProfessionalAvailabilityRule {
  id             String   @id @default(uuid())
  professionalId String
  dayOfWeek      WeekDay
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional User @relation("ProfessionalAvailabilityRules", fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([professionalId, dayOfWeek, isActive])
  @@map("professional_availability_rules")
}

model ProfessionalAvailabilityException {
  id             String   @id @default(uuid())
  professionalId String
  date           DateTime @db.Date
  startTime      String?
  endTime        String?
  reason         String?
  isFullDay      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional User @relation("ProfessionalAvailabilityExceptions", fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([professionalId, date])
  @@map("professional_availability_exceptions")
}

model Booking {
  id                             String                @id @default(uuid())
  clientId                       String
  professionalId                 String
  sessionOfferingId              String
  scheduledStartAt               DateTime
  scheduledEndAt                 DateTime
  timezone                       String                @default("America/La_Paz")
  status                         BookingStatus         @default(PENDING_PAYMENT)
  priceBob                       Decimal               @db.Decimal(10, 2)
  priceUsd                       Decimal               @db.Decimal(10, 2)
  originalPriceBob               Decimal?              @db.Decimal(10, 2)
  originalPriceUsd               Decimal?              @db.Decimal(10, 2)
  currency                       String
  paymentMethod                  BookingPaymentMethod?
  paymentStatus                  BookingPaymentStatus  @default(PENDING)
  expiresAt                      DateTime?
  reminder15SentAt               DateTime?
  reminder10BeforeStartSentAt    DateTime?
  reminder15BeforeEndSentAt      DateTime?
  professionalPurchaseNotifiedAt DateTime?
  professionalJoinedAt           DateTime?
  clientJoinedAt                 DateTime?
  noShowType                     NoShowType?
  refundWindowExpiresAt          DateTime?
  rescheduleCount                Int                   @default(0)
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  client             User                        @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  professional       User                        @relation("ProfessionalBookings", fields: [professionalId], references: [id], onDelete: Cascade)
  sessionOffering    ProfessionalSessionOffering @relation(fields: [sessionOfferingId], references: [id], onDelete: Restrict)
  payments           BookingPayment[]
  earning            BookingEarning?
  review             BookingReview?
  rescheduleRequests BookingRescheduleRequest[]
  refundRequest      RefundRequest?

  @@index([clientId])
  @@index([professionalId])
  @@index([sessionOfferingId])
  @@index([scheduledStartAt])
  @@index([status])
  @@index([professionalId, scheduledStartAt, scheduledEndAt])
  @@map("bookings")
}

enum NoShowType {
  PROFESSIONAL
  CLIENT
  BOTH
}

model BookingRescheduleRequest {
  id                String                         @id @default(uuid())
  bookingId         String
  requestedByUserId String
  requestedByRole   UserRole
  currentStartAt    DateTime
  currentEndAt      DateTime
  proposedStartAt   DateTime
  proposedEndAt     DateTime
  proposedTimezone  String
  reason            String?                        @db.Text
  status            BookingRescheduleRequestStatus @default(PENDING)
  respondedByUserId String?
  respondedAt       DateTime?
  responseNote      String?                        @db.Text
  requestExpiresAt  DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedByUser User    @relation("BookingRescheduleRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  respondedByUser User?   @relation("BookingRescheduleRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, status])
  @@index([requestedByUserId, status, createdAt])
  @@index([respondedByUserId, status, createdAt])
  @@map("booking_reschedule_requests")
}

model BookingPayment {
  id                String               @id @default(uuid())
  bookingId         String
  method            BookingPaymentMethod
  status            BookingPaymentStatus @default(PENDING)
  amountBob         Decimal?             @db.Decimal(10, 2)
  amountUsd         Decimal?             @db.Decimal(10, 2)
  originalAmountBob Decimal?             @db.Decimal(10, 2)
  originalAmountUsd Decimal?             @db.Decimal(10, 2)
  currency          String
  providerReference String?
  providerPayload   Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  earning BookingEarning?

  @@index([bookingId])
  @@index([status])
  @@map("booking_payments")
}

model BookingEarning {
  id                        String               @id @default(uuid())
  bookingId                 String               @unique
  bookingPaymentId          String               @unique
  professionalId            String
  clientId                  String
  walletId                  String
  transactionId             String?              @unique
  currency                  String
  grossAmount               Decimal              @db.Decimal(10, 2)
  platformCommissionPercent Decimal              @db.Decimal(5, 2)
  platformCommissionAmount  Decimal              @db.Decimal(10, 2)
  professionalAmount        Decimal              @db.Decimal(10, 2)
  paymentMethod             BookingPaymentMethod
  status                    BookingEarningStatus @default(CREDITED)
  availableForWithdrawalAt  DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingPayment BookingPayment @relation(fields: [bookingPaymentId], references: [id], onDelete: Cascade)
  professional   User           @relation("ProfessionalBookingEarnings", fields: [professionalId], references: [id], onDelete: Cascade)
  client         User           @relation("ClientBookingEarnings", fields: [clientId], references: [id], onDelete: Cascade)
  wallet         Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([professionalId, createdAt])
  @@index([clientId, createdAt])
  @@index([walletId, createdAt])
  @@index([walletId, availableForWithdrawalAt])
  @@map("booking_earnings")
}

model SystemConfig {
  id                                String   @id @default("global")
  platformFeePercent                Decimal  @default(50.00) @db.Decimal(5, 2)
  creditToSolesRate                 Decimal  @default(1.00) @db.Decimal(10, 2)
  usdExchangeRate                   Decimal  @default(6.96) @db.Decimal(10, 4)
  minAppVersion                     String   @default("1.0")
  referralPercentage                Decimal  @default(2.50) @db.Decimal(5, 2)
  referralRewardCredits             Decimal  @default(10.00) @db.Decimal(10, 2)
  referralMinDepositAmount          Decimal  @default(0.00) @db.Decimal(10, 2)
  referralEnabled                   Boolean  @default(true)
  referralValidPurchasesRequired    Int      @default(1)
  referralThreshold                 Int      @default(10)
  referralClientDiscountPercent     Decimal  @default(5.00) @db.Decimal(5, 2)
  referralClientDiscountSessions    Int      @default(10)
  referralProfessionalRewardPercent Decimal  @default(5.00) @db.Decimal(5, 2)
  paymentsEnabled                   Boolean  @default(true)
  withdrawalsEnabled                Boolean  @default(true)
  noShowGraceMinutes                Int      @default(15)
  noShowPenaltyPercent              Decimal  @default(30.00) @db.Decimal(5, 2)
  refundEarlyWindowMinutes          Int      @default(1440)
  refundEarlyPercent                Decimal  @default(50.00) @db.Decimal(5, 2)
  refundLateWindowMinutes           Int      @default(2880)
  refundLatePercent                 Decimal  @default(80.00) @db.Decimal(5, 2)
  earningLockMinutes                Int      @default(1440)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @default(now()) @updatedAt

  @@map("system_config")
}

model BookingReview {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  clientId       String
  professionalId String
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client       User    @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  professional User    @relation("ProfessionalReviews", fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([clientId])
  @@map("booking_reviews")
}

model ProfessionalImmediateAvailability {
  id              String    @id @default(uuid())
  professionalId  String    @unique
  isActive        Boolean   @default(false)
  expiresAt       DateTime?
  durationMinutes Int
  priceBob        Decimal   @db.Decimal(10, 2)
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  professional User @relation("ProfessionalImmediateAvailability", fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("professional_immediate_availability")
}

